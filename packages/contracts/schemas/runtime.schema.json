{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://maaverge.local/contracts/runtime.schema.json",
  "$comment": "Authoritative runtime contract. Edit this source, then run pnpm contracts:generate. Defaults are applied by the application models, not validators.",
  "$defs": {
    "Budgets": {
      "additionalProperties": false,
      "properties": {
        "originium": {
          "default": 0,
          "maximum": 100,
          "minimum": 0,
          "title": "Originium",
          "type": "integer"
        },
        "medicine": {
          "default": 0,
          "maximum": 100,
          "minimum": 0,
          "title": "Medicine",
          "type": "integer"
        },
        "expedited": {
          "default": 0,
          "maximum": 100,
          "minimum": 0,
          "title": "Expedited",
          "type": "integer"
        }
      },
      "required": [
        "originium",
        "medicine",
        "expedited"
      ],
      "title": "Budgets",
      "type": "object"
    },
    "CaptureSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": { "type": "string", "enum": ["adb", "mumu", "ldplayer"], "default": "adb" },
        "autoDetect": { "type": "boolean", "description": "连接时自动识别模拟器并配置增强截图；省略时 adb 为自动，已有增强截图为手动。" },
        "emulatorPath": { "type": "string", "maxLength": 4096, "default": "" },
        "instanceIndex": { "type": "integer", "minimum": 0, "maximum": 65535, "default": 0 },
        "mumuTouch": { "type": "boolean", "default": false },
        "mumuBridge": { "type": "boolean", "default": false }
      },
      "required": ["method", "emulatorPath", "instanceIndex"]
    },
    "ConnectionSettings": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "adbPath": { "type": "string", "maxLength": 4096, "default": "" },
        "address": { "type": "string", "maxLength": 128, "default": "" },
        "config": { "type": "string", "enum": ["General", "BlueStacks", "MuMuEmulator12", "MuMuArm", "LDPlayer", "Nox", "XYAZ", "Compatible", "SecondResolution", "CompatMac", "CompatPOSIXShell", "Waydroid", "AVD", "Androws", "WSA"], "default": "General" },
        "touchMode": { "type": "string", "enum": ["minitouch", "maatouch", "adb", "MaaFwAdb"], "default": "maatouch" },
        "adbLite": { "type": "boolean", "default": false },
        "clientType": { "type": "string", "enum": ["Official", "Bilibili", "YoStarEN", "YoStarJP", "YoStarKR", "txwy"], "default": "Official" }
      },
      "required": ["adbPath", "address", "config", "touchMode", "adbLite", "clientType"]
    },
    "DeviceConnectionProfile": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "address", "connection", "capture"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Za-z0-9_-]+$" },
        "autoDetected": { "type": "boolean", "description": "由运行中的模拟器自动发现创建；用户编辑保存后转为手动管理。" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "address": { "type": "string", "minLength": 1, "maxLength": 128 },
        "connection": { "$ref": "#/$defs/ConnectionSettings" },
        "capture": { "$ref": "#/$defs/CaptureSettings" }
      }
    },
    "Device": {
      "additionalProperties": false,
      "properties": {
        "connectionProfileId": { "type": "string", "maxLength": 80 },
        "connectionError": { "type": "string", "maxLength": 4096 },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "address": {
          "title": "Address",
          "type": "string"
        },
        "state": {
          "enum": [
            "idle",
            "running",
            "offline"
          ],
          "title": "State",
          "type": "string"
        },
        "coreVersion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coreversion"
        },
        "captureMethod": { "type": "string", "maxLength": 128 },
        "dataSync": { "$ref": "#/$defs/UserDataSync" },
        "resourceVersion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resourceversion"
        }
      },
      "required": [
        "id",
        "name",
        "address",
        "state",
        "coreVersion",
        "resourceVersion"
      ],
      "title": "Device",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "createdAt": {
          "title": "Createdat",
          "type": "string"
        },
        "data": {
          "additionalProperties": true,
          "title": "Data",
          "type": "object"
        }
      },
      "required": [
        "id",
        "type",
        "message",
        "createdAt",
        "data"
      ],
      "title": "Event",
      "type": "object"
    },
    "ModelSettings": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "default": "none",
          "title": "Provider",
          "type": "string"
        },
        "baseUrl": {
          "default": "",
          "title": "Baseurl",
          "type": "string"
        },
        "model": {
          "default": "",
          "title": "Model",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "baseUrl",
        "model"
      ],
      "title": "ModelSettings",
      "type": "object"
    },
    "Plan": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "default": "",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 500,
          "title": "Description",
          "type": "string"
        },
        "deviceId": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deviceid"
        },
        "group": {
          "default": "daily",
          "enum": [
            "daily",
            "specialized"
          ],
          "title": "Group",
          "type": "string"
        },
        "budgets": {
          "anyOf": [
            {
              "$ref": "#/$defs/Budgets"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tasks": {
          "items": {
            "$ref": "#/$defs/Task"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Tasks",
          "type": "array"
        },
        "schedule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schedule"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "deviceId",
        "group",
        "budgets",
        "tasks",
        "schedule",
        "enabled"
      ],
      "title": "Plan",
      "type": "object"
    },
    "Run": {
      "additionalProperties": false,
      "properties": {
        "planName": { "type": "string", "maxLength": 80 },
        "tasks": { "type": "array", "maxItems": 31, "items": { "$ref": "#/$defs/RunTask" } },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "planId": {
          "title": "Planid",
          "type": "string"
        },
        "deviceId": {
          "title": "Deviceid",
          "type": "string"
        },
        "status": {
          "enum": [
            "running",
            "completed",
            "failed",
            "stopped"
          ],
          "title": "Status",
          "type": "string"
        },
        "progress": {
          "maximum": 100,
          "minimum": 0,
          "title": "Progress",
          "type": "integer"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "startedAt": {
          "title": "Startedat",
          "type": "string"
        },
        "finishedAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finishedat"
        },
        "scheduleId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "scheduledFor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "required": [
        "id",
        "planId",
        "deviceId",
        "status",
        "progress",
        "message",
        "startedAt",
        "finishedAt"
      ],
      "title": "Run",
      "type": "object"
    },
    "RunTask": {
      "type": "object", "additionalProperties": false,
      "required": ["index", "type", "status", "message", "startedAt", "finishedAt", "drops", "infrastructure", "artifacts"],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "maximum": 30 },
        "type": { "type": "string", "maxLength": 80 },
        "status": { "enum": ["waiting", "running", "completed", "failed", "stopped", "skipped"] },
        "message": { "type": "string", "maxLength": 1000 },
        "startedAt": { "type": ["string", "null"] }, "finishedAt": { "type": ["string", "null"] },
        "drops": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/RunDrop" } },
        "infrastructure": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/RunInfrastructure" } },
        "artifacts": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/RunArtifact" } }
      }
    },
    "RunDrop": {
      "type": "object", "additionalProperties": false, "required": ["itemId", "name", "quantity", "stage", "at"],
      "properties": {
        "itemId": { "type": "string", "minLength": 1, "maxLength": 200 }, "name": { "type": "string", "maxLength": 200 },
        "quantity": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "stage": { "type": "string", "maxLength": 200 }, "at": { "type": "string" }
      }
    },
    "RunInfrastructure": {
      "type": "object", "additionalProperties": false, "required": ["facility", "room", "operators", "product", "message", "at"],
      "properties": {
        "facility": { "type": "string", "maxLength": 80 }, "room": { "type": "integer", "minimum": 0, "maximum": 100 },
        "operators": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 80 } },
        "staffingStatus": { "description": "Latest staffing evidence; configured names are not an independently recognized final roster.", "enum": ["planned", "confirmed", "unavailable"] },
        "product": { "type": "string", "maxLength": 200 }, "message": { "type": "string", "maxLength": 500 }, "at": { "type": "string" }
      }
    },
    "RunArtifact": {
      "description": "Bounded local observation captured after a native result callback, not the original recognition image. PNG bytes are fetched separately and never stored in snapshots or SQLite.",
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "label", "capturedAt", "width", "height"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-f0-9-]{36}$" }, "kind": { "const": "screenshot" },
        "label": { "type": "string", "maxLength": 100 }, "capturedAt": { "type": "string" },
        "width": { "type": "integer", "minimum": 1, "maximum": 8192 }, "height": { "type": "integer", "minimum": 1, "maximum": 8192 }
      }
    },
    "InfrastructureLine": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "unit", "hourlyRate", "capacity", "lastCollectedAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 100 },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "unit": { "type": "string", "minLength": 1, "maxLength": 20 },
        "hourlyRate": { "type": "number", "minimum": 0, "maximum": 1000000000 },
        "capacity": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000000 },
        "lastCollectedAt": { "type": "string", "minLength": 20, "maxLength": 40 }
      }
    },
    "InfrastructureEstimateProfile": {
      "type": "object", "additionalProperties": false, "required": ["deviceId", "lines"],
      "properties": {
        "deviceId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "lines": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/InfrastructureLine" } }
      }
    },
    "ComponentPaths": {
      "description": "Absolute installation/download roots. An empty string restores the application default on settings.save.",
      "type": "object", "additionalProperties": false, "required": ["core", "resource"],
      "properties": {
        "core": { "type": "string", "maxLength": 4096 },
        "resource": { "type": "string", "maxLength": 4096 }
      }
    },
    "ComponentDownload": {
      "description": "Component download engine; defaults to bundled aria2. Empty aria2Path uses aria2c beside the packaged service, or checkout/.tools/aria2 in development; otherwise use an absolute executable path. Never searches PATH. Changes apply to subsequent downloads.",
      "type": "object", "additionalProperties": false, "required": ["engine", "aria2Path"],
      "properties": {
        "engine": { "type": "string", "enum": ["builtin", "aria2"] },
        "aria2Path": { "type": "string", "maxLength": 4096 }
      }
    },
    "ResourceActivityVersion": {
      "type": "object", "additionalProperties": false, "required": ["clientType", "name", "lastUpdated"],
      "properties": {
        "clientType": { "enum": ["Official", "Bilibili", "YoStarEN", "YoStarJP", "YoStarKR", "txwy"] },
        "name": { "type": ["string", "null"], "maxLength": 300 },
        "lastUpdated": { "type": ["string", "null"], "maxLength": 200 }
      }
    },
    "Settings": {
      "additionalProperties": false,
      "properties": {
        "componentPaths": { "$ref": "#/$defs/ComponentPaths" },
        "componentDownload": { "$ref": "#/$defs/ComponentDownload" },
        "infrastructureEstimates": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/InfrastructureEstimateProfile" } },
        "capture": { "$ref": "#/$defs/CaptureSettings" },
        "connection": { "$ref": "#/$defs/ConnectionSettings" },
        "deviceProfiles": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/DeviceConnectionProfile" } },
        "logRetentionDays": { "type": "integer", "enum": [0, 7, 14, 30], "default": 7, "description": "Log retention in days; zero disables automatic cleanup." },
        "autoConnect": {
          "default": true,
          "title": "Autoconnect",
          "type": "boolean"
        },
        "autoUpdateApp": {"type":"boolean","default":true,"description":"启动时检查应用更新；下载和安装始终由用户确认。"},
        "appUpdateChannel": {"type":"string","enum":["stable","preview"],"default":"preview"},
        "coreUpdateChannel": {"type":"string","enum":["stable","preview"],"default":"stable"},
        "autoUpdateCore": {
          "default": true,
          "title": "Autoupdatecore",
          "type": "boolean"
        },
        "autoUpdateResource": {
          "default": true,
          "title": "Autoupdateresource",
          "type": "boolean"
        },
        "minimizeToTray": {
          "default": true,
          "title": "Minimizetotray",
          "type": "boolean"
        },
        "rememberCloseAction": {
          "type": "boolean",
          "default": false,
          "description": "记住 minimizeToTray 指定的关闭方式；缺失或 false 时每次关闭窗口均询问。"
        },
        "theme": {
          "default": "system",
          "enum": [
            "dark",
            "light",
            "system"
          ],
          "title": "Theme",
          "type": "string"
        },
        "budgets": {
          "$ref": "#/$defs/Budgets"
        },
        "model": {
          "$ref": "#/$defs/ModelSettings"
        },
        "scheduler": {
          "$ref": "#/$defs/SchedulerSettings"
        }
      },
      "required": [
        "autoConnect",
        "autoUpdateCore",
        "autoUpdateResource",
        "minimizeToTray",
        "theme",
        "budgets",
        "model"
      ],
      "title": "Settings",
      "type": "object"
    },
    "UserDataSync": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operatorsAt": { "type": ["string", "null"], "maxLength": 64 },
        "depotAt": { "type": ["string", "null"], "maxLength": 64 }
      },
      "required": ["operatorsAt", "depotAt"]
    },
    "Task": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "StartUp",
            "CloseDown",
            "Fight",
            "Recruit",
            "Infrast",
            "Mall",
            "Award",
            "SwitchTheme",
            "Roguelike",
            "Copilot",
            "SSSCopilot",
            "ParadoxCopilot",
            "Depot",
            "OperBox",
            "Reclamation",
            "Custom",
            "SingleStep",
            "VideoRecognition",
            "OperProgress",
            "UserDataUpdate"
          ],
          "title": "Type",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "params",
        "enabled"
      ],
      "title": "Task",
      "type": "object"
    },
    "UpdateChannel": {
      "additionalProperties": false,
      "properties": {
        "checkedAt": {"type":"string","maxLength":64},
        "appCanInstall": {"type":"boolean","description":"此安装形式是否支持签名自动更新。"},
        "appRelease": {"type":"object","additionalProperties":false,"required":["url","notes","publishedAt","prerelease"],"properties":{"url":{"type":"string","maxLength":2048},"notes":{"type":"string","maxLength":16384},"publishedAt":{"type":"string","maxLength":64},"prerelease":{"type":"boolean"}}},
        "installDirectory": { "type": "string", "maxLength": 4096 },
        "resourceActivities": { "type": "array", "maxItems": 6, "items": { "$ref": "#/$defs/ResourceActivityVersion" } },
        "id": {
          "enum": [
            "app",
            "core",
            "resource"
          ],
          "title": "Id",
          "type": "string"
        },
        "currentVersion": {
          "title": "Currentversion",
          "type": "string"
        },
        "latestVersion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latestversion"
        },
        "status": {
          "default": "idle",
          "enum": [
            "idle",
            "checking",
            "available",
            "downloading",
            "staged",
            "waiting_idle",
            "active",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "progress": {
          "default": 0,
          "maximum": 100,
          "minimum": 0,
          "title": "Progress",
          "type": "integer"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "id",
        "currentVersion",
        "latestVersion",
        "status",
        "progress",
        "message"
      ],
      "title": "UpdateChannel",
      "type": "object"
    },
    "SchedulerSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "forceScheduledStart": {
          "type": "boolean"
        },
        "showWindowBeforeForceScheduledStart": {
          "type": "boolean"
        },
        "notifyBeforeScheduledStart": {
          "type": "boolean"
        },
        "notificationMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1439
        },
        "scheduledWakeUp": {
          "type": "boolean"
        }
      },
      "required": [
        "forceScheduledStart",
        "showWindowBeforeForceScheduledStart",
        "notifyBeforeScheduledStart",
        "notificationMinutes",
        "scheduledWakeUp"
      ]
    },
    "ToolJobSummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "enum": [
            "depot",
            "operators",
            "recruit",
            "inventory",
            "data",
            "games"
          ]
        },
        "deviceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "clientType": {
          "enum": [
            "Official",
            "Bilibili",
            "YoStarEN",
            "YoStarJP",
            "YoStarKR",
            "txwy"
          ]
        },
        "status": {
          "enum": [
            "running",
            "completed",
            "failed",
            "stopped"
          ]
        },
        "progress": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "message": {
          "type": "string",
          "maxLength": 1000
        },
        "startedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "finishedAt": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "deviceId",
        "clientType",
        "status",
        "progress",
        "message",
        "startedAt",
        "finishedAt"
      ]
    }
  },
  "additionalProperties": false,
  "properties": {
    "mode": {
      "enum": [
        "native"
      ],
      "title": "Mode",
      "type": "string"
    },
    "devices": {
      "items": {
        "$ref": "#/$defs/Device"
      },
      "title": "Devices",
      "type": "array"
    },
    "plans": {
      "items": {
        "$ref": "#/$defs/Plan"
      },
      "title": "Plans",
      "type": "array"
    },
    "runs": {
      "items": {
        "$ref": "#/$defs/Run"
      },
      "title": "Runs",
      "type": "array"
    },
    "updates": {
      "items": {
        "$ref": "#/$defs/UpdateChannel"
      },
      "title": "Updates",
      "type": "array"
    },
    "settings": {
      "$ref": "#/$defs/Settings"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/Event"
      },
      "title": "Events",
      "type": "array"
    },
    "toolJobs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ToolJobSummary"
      }
    }
  },
  "required": [
    "mode",
    "devices",
    "plans",
    "runs",
    "updates",
    "settings",
    "events"
  ],
  "title": "Snapshot",
  "type": "object"
}
