{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://maaverge.local/contracts/worker.schema.json",
  "$comment": "NDJSON protocol v1. Every native output carries protocolVersion=1. Parent process owns persistence and task policy.",
  "title": "WorkerProtocol",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "leaseConfiguration",
    "frameworkConfiguration",
    "frameworkCommand",
    "frameworkEvent",
    "frameworkValidation"
  ],
  "properties": {
    "leaseConfiguration": {
      "$ref": "#/$defs/WorkerLeaseConfiguration"
    },
    "frameworkConfiguration": {
      "$ref": "#/$defs/FrameworkWorkerConfiguration"
    },
    "frameworkCommand": {
      "$ref": "#/$defs/FrameworkWorkerCommand"
    },
    "frameworkEvent": {
      "$ref": "#/$defs/FrameworkWorkerEvent"
    },
    "frameworkValidation": {
