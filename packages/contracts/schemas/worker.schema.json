        "mode": {
          "enum": ["recognition", "control"]
        },
        "adb": {
          "type": "string",
          "minLength": 1
        },
        "address": {
          "type": "string",
          "minLength": 1
        },
        "lockPath": {
          "type": "string",
          "minLength": 1
        },
        "avd": {
          "type": "boolean"
        },
        "avdSerial": {
          "type": "string",
          "pattern": "^emulator-([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-4])$",
          "description": "Verified local AVD console identity used only for fixed enhanced screenshot start/stop commands; the controller address and shared lease stay unchanged."
        },
        "touchMode": {
          "enum": ["maatouch", "minitouch", "adb", "emulator-extras"],
          "default": "maatouch"
        },
        "capture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "emulatorPath", "instanceIndex"],
          "properties": {
            "method": {
              "enum": ["auto", "adb", "mumu", "ldplayer", "avd"]
            },
            "emulatorPath": {
              "type": "string",
              "maxLength": 4096
            },
            "instanceIndex": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "pid": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          }
        },
        "touchExtras": {
          "type": "object",
          "additionalProperties": false,
          "required": ["emulatorPath", "instanceIndex"],
          "properties": {
            "emulatorPath": {
              "type": "string",
              "maxLength": 4096
            },
            "instanceIndex": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          }
        },
        "lockTimeoutMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "startupTimeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120000
        },
        "nativeCallTimeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120000
        },
        "asyncTimeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120000
        },
        "shutdownTimeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120000
        }
      }
    },
