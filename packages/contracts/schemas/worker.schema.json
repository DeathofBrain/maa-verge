        "mimeType": {
          "const": "image/png"
        },
        "data": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4183384
        },
        "canControl": {
          "type": "boolean"
        }
      }
    },
    "FrameworkWorkerConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "framework", "resource", "userDir", "mode"],
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "framework": {
          "type": "string",
          "minLength": 1
