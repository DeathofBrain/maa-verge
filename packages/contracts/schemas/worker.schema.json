  "$defs": {
    "WorkerLeaseConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "lockPath"],
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "lockPath": {
          "type": "string",
          "minLength": 1
        },
        "lockTimeoutMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        }
      }
    },
    "WorkerFrame": {
      "type": "object",
