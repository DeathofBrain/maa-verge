{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://maaverge.local/contracts/rpc.schema.json",
  "$comment": "Public NDJSON JSON-RPC method parameter/result maps. Requests and runtime events use the envelope definitions below.",
  "title": "RpcContract",
  "type": "object", "additionalProperties": false, "required": ["params", "results"],
  "properties": {
    "params": {
      "type": "object", "additionalProperties": false,
      "required": ["app.snapshot", "logs.info", "logs.export", "logs.clean", "home.info", "stages.list", "recognition.get", "resources.item", "resources.operator", "plan.save", "plan.delete", "device.discover", "device.connect", "device.auto_connect", "device.disconnect", "device.frame", "device.click", "run.start", "run.stop", "run.detail", "run.artifact", "updates.check", "updates.prepare", "updates.activate", "updates.rollback", "settings.save", "agent.message"],
      "properties": {
        "app.snapshot": { "$ref": "#/$defs/EmptyParams" },
        "logs.info": { "$ref": "#/$defs/EmptyParams" },
        "logs.export": { "$ref": "#/$defs/EmptyParams" },
        "logs.clean": { "$ref": "#/$defs/EmptyParams" },
        "home.info": { "type": "object", "additionalProperties": false, "properties": { "deviceId": { "type": "string", "minLength": 1, "maxLength": 200 }, "clientType": { "enum": ["Official", "Bilibili", "YoStarEN", "YoStarJP", "YoStarKR", "txwy"] }, "refresh": { "type": "boolean" } } },
        "stages.list": { "$ref": "#/$defs/StageListParams" },
        "recognition.get": { "$ref": "#/$defs/RecognitionParams" },
        "resources.item": { "$ref": "#/$defs/ItemResourceParams" },
        "resources.operator": { "$ref": "#/$defs/OperatorResourceParams" },
        "plan.save": { "type": "object", "additionalProperties": false, "required": ["plan"], "properties": { "plan": { "$ref": "./runtime.schema.json#/$defs/Plan" } } },
        "plan.delete": { "$ref": "#/$defs/IdParams" },
        "device.discover": { "$ref": "#/$defs/EmptyParams" },
        "device.connect": { "type": "object", "additionalProperties": false, "required": ["address"], "properties": { "address": { "type": "string" }, "name": { "type": "string" } } },
        "device.auto_connect": { "$ref": "#/$defs/EmptyParams" },
        "device.disconnect": { "$ref": "#/$defs/IdParams" },
        "device.frame": { "$ref": "#/$defs/DeviceFrameParams" },
        "device.click": { "$ref": "#/$defs/DeviceClickParams" },
        "run.start": {
          "type": "object", "additionalProperties": false, "required": ["planId", "deviceId", "requestId"],
          "properties": { "planId": { "type": "string" }, "deviceId": { "type": "string" }, "requestId": { "type": "string", "minLength": 1, "maxLength": 200 } }
        },
        "run.stop": { "$ref": "#/$defs/IdParams" },
        "run.detail": { "$ref": "#/$defs/IdParams" },
        "run.artifact": { "$ref": "#/$defs/RunArtifactParams" },
        "updates.check": { "$ref": "#/$defs/ChannelParams" },
        "updates.prepare": { "$ref": "#/$defs/ChannelParams" },
        "updates.activate": { "$ref": "#/$defs/ChannelParams" },
        "updates.rollback": { "$ref": "#/$defs/ChannelParams" },
        "settings.save": { "type": "object", "additionalProperties": false, "required": ["settings"], "properties": { "settings": { "$ref": "./runtime.schema.json#/$defs/Settings" } } },
        "agent.message": {
          "type": "object", "additionalProperties": false, "required": ["message"],
          "properties": { "message": { "type": "string", "minLength": 1, "maxLength": 4000 }, "deviceId": { "type": "string" } }
        }
      }
    },
    "results": {
      "type": "object", "additionalProperties": false,
      "required": ["app.snapshot", "logs.info", "logs.export", "logs.clean", "home.info", "stages.list", "recognition.get", "resources.item", "resources.operator", "plan.save", "plan.delete", "device.discover", "device.connect", "device.auto_connect", "device.disconnect", "device.frame", "device.click", "run.start", "run.stop", "run.detail", "run.artifact", "updates.check", "updates.prepare", "updates.activate", "updates.rollback", "settings.save", "agent.message"],
      "properties": {
        "app.snapshot": { "$ref": "./runtime.schema.json" },
        "logs.info": { "type": "object", "additionalProperties": false, "required": ["directory", "retentionDays"], "properties": { "directory": { "type": "string" }, "retentionDays": { "type": "integer", "enum": [0, 7, 14, 30] } } },
        "logs.export": { "type": "object", "additionalProperties": false, "required": ["directory", "path", "bytes", "warnings"], "properties": { "directory": { "type": "string" }, "path": { "type": "string" }, "bytes": { "type": "integer", "minimum": 0 }, "warnings": { "type": "array", "items": { "type": "string" } } } },
        "logs.clean": { "type": "object", "additionalProperties": false, "required": ["removedFiles", "removedBytes", "skippedFiles", "warnings"], "properties": { "removedFiles": { "type": "integer", "minimum": 0 }, "removedBytes": { "type": "integer", "minimum": 0 }, "skippedFiles": { "type": "integer", "minimum": 0 }, "warnings": { "type": "array", "items": { "type": "string" } } } },
        "home.info": { "$ref": "#/$defs/HomeInfo" },
        "stages.list": { "$ref": "#/$defs/StageListResult" },
        "recognition.get": { "$ref": "#/$defs/RecognitionResult" },
        "resources.item": { "$ref": "#/$defs/ItemResourceResult" },
        "resources.operator": { "$ref": "#/$defs/OperatorResourceResult" },
        "plan.save": { "$ref": "./runtime.schema.json#/$defs/Plan" },
        "plan.delete": { "type": "object", "additionalProperties": false, "required": ["deleted"], "properties": { "deleted": { "type": "boolean" } } },
        "device.discover": { "type": "array", "items": { "$ref": "#/$defs/DiscoveredDevice" } },
        "device.connect": { "$ref": "./runtime.schema.json#/$defs/Device" },
        "device.auto_connect": {
          "type": "object", "additionalProperties": false, "required": ["devices", "discovered", "diagnostics"],
          "properties": {
            "devices": { "type": "array", "items": { "$ref": "./runtime.schema.json#/$defs/Device" } },
            "discovered": { "type": "array", "items": { "$ref": "#/$defs/DiscoveredDevice" } },
            "diagnostics": { "type": "array", "items": { "type": "string" } }
          }
        },
        "device.disconnect": { "type": "object", "additionalProperties": false, "required": ["disconnected"], "properties": { "disconnected": { "type": "boolean" } } },
        "device.frame": { "$ref": "#/$defs/ScreenFrame" },
        "device.click": { "type": "object", "additionalProperties": false, "required": ["accepted"], "properties": { "accepted": { "const": true } } },
        "run.start": { "$ref": "./runtime.schema.json#/$defs/Run" },
        "run.stop": { "$ref": "./runtime.schema.json#/$defs/Run" },
        "run.detail": { "$ref": "./runtime.schema.json#/$defs/Run" },
        "run.artifact": { "$ref": "#/$defs/RunArtifactImage" },
        "updates.check": { "$ref": "./runtime.schema.json#/$defs/UpdateChannel" },
        "updates.prepare": { "$ref": "./runtime.schema.json#/$defs/UpdateChannel" },
        "updates.activate": { "$ref": "./runtime.schema.json#/$defs/UpdateChannel" },
        "updates.rollback": { "$ref": "./runtime.schema.json#/$defs/UpdateChannel" },
        "settings.save": { "$ref": "./runtime.schema.json#/$defs/Settings" },
        "agent.message": {
          "type": "object", "additionalProperties": false, "required": ["reply", "requiresConfirmation", "mode"],
          "properties": { "reply": { "type": "string" }, "plan": { "$ref": "./runtime.schema.json#/$defs/Plan" }, "requiresConfirmation": { "type": "boolean" }, "mode": { "type": "string" } }
        }
      }
    }
  },
  "$defs": {
    "RecognitionParams": {
      "type": "object", "additionalProperties": false, "required": ["deviceId", "kind"],
      "properties": {
        "deviceId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "kind": { "enum": ["depot", "operators"] },
        "clientType": { "$ref": "#/$defs/ClientType" }
      }
    },
    "RecognitionResult": {
      "type": "object", "additionalProperties": false,
      "required": ["deviceId", "kind", "clientType", "collectedAt", "runId", "items", "operators"],
      "properties": {
        "deviceId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "kind": { "enum": ["depot", "operators"] },
        "clientType": { "$ref": "#/$defs/ClientType" },
        "collectedAt": { "type": ["string", "null"], "minLength": 1, "maxLength": 40 },
        "runId": { "type": ["string", "null"], "minLength": 1, "maxLength": 200 },
        "items": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/RecognizedItem" } },
        "operators": { "type": "array", "maxItems": 2000, "items": { "$ref": "#/$defs/RecognizedOperator" } }
      }
    },
    "RecognizedItem": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "quantity"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "name": { "type": "string", "minLength": 1, "maxLength": 300 },
        "quantity": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
      }
    },
    "RecognizedOperator": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "own", "elite", "level", "potential", "rarity"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "name": { "type": "string", "minLength": 1, "maxLength": 300 },
        "own": { "type": "boolean" },
        "elite": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "level": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "potential": { "description": "MaaCore potential: 1-based; negative values preserve unknown results.", "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "rarity": { "description": "MaaCore rarity: 1-based star count; negative values preserve unknown results.", "type": "integer", "minimum": -2147483648, "maximum": 2147483647 }
      }
    },
    "ItemResourceParams": {
      "type": "object", "additionalProperties": false, "required": ["itemId"],
      "properties": {
        "itemId": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9_-]+$" },
        "clientType": { "$ref": "#/$defs/ClientType" }
      }
    },
    "ItemResourceResult": {
      "type": "object", "additionalProperties": false, "required": ["itemId", "name", "mimeType", "data", "resourceVersion"],
      "properties": {
        "itemId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "name": { "type": ["string", "null"], "maxLength": 300 },
        "mimeType": { "enum": ["image/png", null] },
        "data": { "type": ["string", "null"], "maxLength": 1398104 },
        "resourceVersion": { "type": ["string", "null"], "maxLength": 200 }
      }
    },
    "OperatorResourceParams": {
      "type": "object", "additionalProperties": false, "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
        "clientType": { "$ref": "#/$defs/ClientType" }
      }
    },
    "OperatorResourceResult": {
      "description": "Bounded artwork and metadata from the active installed MaaResource; missing or ambiguous names keep text and known rarity without guessing an avatar.",
      "type": "object", "additionalProperties": false, "required": ["name", "id", "rarity", "mimeType", "data", "resourceVersion"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 300 },
        "id": { "type": ["string", "null"], "maxLength": 200 },
        "rarity": { "description": "1-based star count; null means unknown or conflicting candidates.", "type": ["integer", "null"], "minimum": 1, "maximum": 6 },
        "mimeType": { "enum": ["image/png", null] },
        "data": { "type": ["string", "null"], "maxLength": 699052 },
        "resourceVersion": { "type": ["string", "null"], "maxLength": 200 }
      }
    },
    "RunArtifactParams": {
      "type": "object", "additionalProperties": false, "required": ["runId", "artifactId"],
      "properties": { "runId": { "type": "string", "minLength": 1, "maxLength": 200 }, "artifactId": { "type": "string", "pattern": "^[a-f0-9-]{36}$" } }
    },
    "RunArtifactImage": {
      "type": "object", "additionalProperties": false, "required": ["mimeType", "data"],
      "properties": { "mimeType": { "const": "image/png" }, "data": { "type": "string", "minLength": 1, "maxLength": 4183384 } }
    },
    "HomeInfo": {
      "type": "object", "additionalProperties": false,
      "required": ["generatedAt", "clientType", "gameDate", "weekday", "nextDailyResetAt", "nextWeeklyResetAt", "annihilation", "infrastructure", "activityCatalog"],
      "properties": {
        "generatedAt": { "type": "string" },
        "clientType": { "enum": ["Official", "Bilibili", "YoStarEN", "YoStarJP", "YoStarKR", "txwy"] },
        "gameDate": { "type": "string" },
        "weekday": { "type": "integer", "minimum": 0, "maximum": 6 },
        "nextDailyResetAt": { "type": "string" },
        "nextWeeklyResetAt": { "type": "string" },
        "activityCatalog": { "$ref": "#/$defs/StageListResult" },
        "annihilation": {
          "type": "object", "additionalProperties": false, "required": ["kind", "message"],
          "properties": { "kind": { "enum": ["weekly-reset", "weekly-last-day", "weekly"] }, "message": { "type": "string" } }
        },
        "infrastructure": {
          "type": "object", "additionalProperties": false, "required": ["deviceId", "message", "lines"],
          "properties": {
            "deviceId": { "type": ["string", "null"] }, "message": { "type": "string" },
            "lines": { "type": "array", "items": { "$ref": "#/$defs/InfrastructureEstimate" } }
          }
        }
      }
    },
    "InfrastructureEstimate": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "unit", "estimatedQuantity", "capacity", "hourlyRate", "lastCollectedAt", "full", "fullAt", "error"],
      "properties": {
        "id": { "type": "string" }, "name": { "type": "string" }, "unit": { "type": "string" },
        "estimatedQuantity": { "type": ["number", "null"], "minimum": 0 },
        "capacity": { "type": "number", "exclusiveMinimum": 0 },
        "hourlyRate": { "type": "number", "minimum": 0 },
        "lastCollectedAt": { "type": "string" }, "full": { "type": "boolean" },
        "fullAt": { "type": ["string", "null"] }, "error": { "type": ["string", "null"] }
      }
    },
    "ClientType": { "enum": ["Official", "Bilibili", "YoStarEN", "YoStarJP", "YoStarKR", "txwy"] },
    "StageListParams": {
      "type": "object", "additionalProperties": false,
      "properties": { "clientType": { "$ref": "#/$defs/ClientType" }, "refresh": { "type": "boolean" } }
    },
    "StageOption": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "label", "category", "available"],
      "properties": {
        "value": { "type": "string", "maxLength": 200 },
        "label": { "type": "string", "minLength": 1, "maxLength": 300 },
        "category": { "enum": ["default", "activity", "permanent"] },
        "available": { "type": "boolean" },
        "tip": { "type": "string", "maxLength": 1000 },
        "activityId": { "type": "string", "maxLength": 200 }
      }
    },
    "StageActivity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "startAt", "endAt", "clientType", "status", "source"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "name": { "type": "string", "minLength": 1, "maxLength": 300 },
        "startAt": { "type": ["string", "null"], "maxLength": 40 },
        "endAt": { "type": ["string", "null"], "maxLength": 40 },
        "clientType": { "$ref": "#/$defs/ClientType" },
        "status": { "enum": ["active", "upcoming", "unknown"] },
        "source": { "enum": ["official-calendar", "activity-metadata", "resource-version"] }
      }
    },
    "CalendarStatus": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "url", "fetchedAt", "checkedAt", "nextRefreshAt", "stale", "refreshing", "error"],
      "properties": {
        "source": { "enum": ["official-cache", "installed", "unavailable"] },
        "url": { "type": ["string", "null"], "maxLength": 300 },
        "fetchedAt": { "type": ["string", "null"], "maxLength": 40 },
        "checkedAt": { "type": ["string", "null"], "maxLength": 40 },
        "nextRefreshAt": { "type": ["string", "null"], "maxLength": 40 },
        "stale": { "type": "boolean" },
        "refreshing": { "type": "boolean" },
        "error": { "type": ["string", "null"], "maxLength": 1000 }
      }
    },
    "StageListResult": {
      "type": "object", "additionalProperties": false,
      "required": ["clientType", "resourceVersion", "source", "generatedAt", "stages", "activities", "calendar", "message", "diagnostics"],
      "properties": {
        "clientType": { "$ref": "#/$defs/ClientType" },
        "resourceVersion": { "type": ["string", "null"], "maxLength": 200 },
        "source": { "enum": ["installed", "builtin"] },
        "generatedAt": { "type": "string", "maxLength": 40 },
        "stages": { "type": "array", "maxItems": 2000, "items": { "$ref": "#/$defs/StageOption" } },
        "activities": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/StageActivity" } },
        "calendar": { "$ref": "#/$defs/CalendarStatus" },
        "message": { "type": "string", "maxLength": 1000 },
        "diagnostics": { "type": "array", "items": { "type": "string", "maxLength": 1000 } }
      }
    },
    "DeviceFrameParams": {
      "type": "object", "additionalProperties": false, "required": ["deviceId"],
      "properties": { "deviceId": { "type": "string", "minLength": 1, "maxLength": 200 } }
    },
    "DeviceClickParams": {
      "type": "object", "additionalProperties": false, "required": ["deviceId", "frameId", "x", "y", "requestId"],
      "properties": {
        "deviceId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "frameId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "x": { "type": "integer", "minimum": 0, "maximum": 8191 },
        "y": { "type": "integer", "minimum": 0, "maximum": 8191 },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "ScreenFrame": {
      "description": "Transient MaaCore preview PNG. Its width/height are the click coordinate space; image bytes never enter snapshots or persistence.",
      "type": "object", "additionalProperties": false,
      "required": ["deviceId", "frameId", "capturedAt", "width", "height", "mimeType", "data", "canControl", "latencyMs"],
      "properties": {
        "deviceId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "frameId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "capturedAt": { "type": "string", "minLength": 1, "maxLength": 40 },
        "width": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "height": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "mimeType": { "const": "image/png" },
        "data": { "type": "string", "minLength": 1, "maxLength": 4183384 },
        "canControl": { "type": "boolean" },
        "latencyMs": { "type": "number", "minimum": 0 }
      }
    },
    "EmptyParams": { "type": "object", "additionalProperties": false },
    "IdParams": { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "type": "string" } } },
    "ChannelParams": { "type": "object", "additionalProperties": false, "required": ["channel"], "properties": { "channel": { "enum": ["app", "core", "resource"] } } },
    "DiscoveredDevice": {
      "type": "object", "additionalProperties": false, "required": ["address", "name", "adbState"],
      "properties": { "address": { "type": "string" }, "name": { "type": "string" }, "adbState": { "type": "string" } }
    },
    "RpcRequest": {
      "type": "object", "additionalProperties": false, "required": ["jsonrpc", "method"],
      "properties": { "jsonrpc": { "const": "2.0" }, "method": { "type": "string" }, "id": { "type": ["string", "integer", "null"] }, "params": { "type": "object", "additionalProperties": true } }
    },
    "RpcEvent": {
      "type": "object", "additionalProperties": false, "required": ["jsonrpc", "method", "params"],
      "properties": { "jsonrpc": { "const": "2.0" }, "method": { "const": "runtime.event" }, "params": { "$ref": "./runtime.schema.json#/$defs/Event" } }
    }
  }
}
