# Copy to .env for documentation only. Shell/CI environment variables take precedence.
# Tools do not automatically source .env (avoids executing shell code).
MAAVERGE_MODE=native
# Defaults to <program>/config; development uses <checkout>/config.
# MAAVERGE_DATA_DIR=
# MAAVERGE_DEVICE_LOCK_DIR=
# Override the diagnostic export directory (absolute path); development defaults stay isolated.
# MAAVERGE_LOG_DIR=
# MAAVERGE_ADB_PATH=
# MAAVERGE_EMULATOR_DIRS=
# MAAVERGE_EMULATOR_ADDRESSES=
# MAAVERGE_BLUESTACKS_CONFIG=
# MAAVERGE_DEV_PORT=1420
# Cloud models are not integrated yet. Future credentials must use the OS keychain.
# Do not place model keys or account data in this file or commit them to Git.
