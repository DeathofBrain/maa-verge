{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Maa Verge",
  "version": "0.1.0",
  "identifier": "io.maaverge.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Maa Verge",
        "width": 1360,
        "height": 900,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "backgroundColor": "#f5f7fa"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; font-src 'self'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/256x256.png", "icons/icon.ico", "icons/icon.icns"],
    "targets": "all",
    "resources": {
      "../../../dist/runtime/maaverge-runtime/": "runtime/"
    },
    "macOS": {
      "minimumSystemVersion": "13.3",
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "wix": { "language": "zh-CN" },
      "nsis": { "languages": ["SimpChinese"], "displayLanguageSelector": false }
    }
  }
}
