{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Maa Verge",
  "version": "0.1.3-alpha1",
  "identifier": "io.maaverge.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Maa Verge",
        "width": 1360,
        "height": 900,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "backgroundColor": "#f5f7fa"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; font-src 'self'; object-src 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBCNUQzNjM2NTU4OUEyQUUKUldTdW9vbFZOalpkQ3czYkdWdit1U2ZGdmszYUZnaEpDNlVKSkQwVmtRVHlqaWVWVTVUMS9jZTkK",
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "targets": "all",
    "resources": {
      "../../../dist/runtime/maaverge-runtime/": "runtime/"
    },
    "macOS": {
      "minimumSystemVersion": "13.5",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installerHooks": "installer/hooks.nsh"
      }
    }
  }
}
