<?xml version="1.0" encoding="UTF-8"?>
<?if $(sys.BUILDARCH) = "x86" ?>
  <?define MaaVergeWin64 = "no" ?>
<?else?>
  <?define MaaVergeWin64 = "yes" ?>
<?endif?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <Fragment>
    <!-- INSTALLDIR is restored by Tauri's AppSearch before CostInitialize.
         RemoveFolderEx needs its paths before directory costing. Keep these
         properties unset during repairs and application upgrades. -->
    <SetProperty Id="MAAVERGE_CORE_CLEANUP_DIR" Value="[INSTALLDIR]\MaaCore"
                 Before="WixRemoveFoldersEx" Sequence="execute">
      Installed AND INSTALLDIR AND REMOVE = "ALL" AND NOT UPGRADINGPRODUCTCODE
    </SetProperty>
    <SetProperty Id="MAAVERGE_RESOURCE_CLEANUP_DIR" Value="[INSTALLDIR]\MaaResource"
                 Before="WixRemoveFoldersEx" Sequence="execute">
      Installed AND INSTALLDIR AND REMOVE = "ALL" AND NOT UPGRADINGPRODUCTCODE
    </SetProperty>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="MaaVergeDownloadedComponents" Guid="6E6353BA-742A-499F-9D9F-426E5D2F123C" KeyPath="yes" Win64="$(var.MaaVergeWin64)">
        <util:RemoveFolderEx Id="MaaVergeRemoveCore" Property="MAAVERGE_CORE_CLEANUP_DIR" On="uninstall" />
        <util:RemoveFolderEx Id="MaaVergeRemoveResource" Property="MAAVERGE_RESOURCE_CLEANUP_DIR" On="uninstall" />
      </Component>
    </DirectoryRef>
    <ComponentGroup Id="MaaVergeDownloadedComponents">
      <ComponentRef Id="MaaVergeDownloadedComponents" />
    </ComponentGroup>
  </Fragment>
</Wix>
