{
  "name": "maa-verge",
  "private": true,
  "version": "0.1.2",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "prepare": "node tools/setup-git-hooks.mjs",
    "dev:ui": "node tools/dev.mjs --ui-only",
    "dev": "node tools/dev.mjs",
    "doctor": "node tools/doctor.mjs",
    "check": "node tools/check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:staged": "lint-staged",
    "build": "node tools/build.mjs",
    "contracts:generate": "node tools/generate-contracts.mjs",
    "contracts:check": "node tools/generate-contracts.mjs --check",
    "test:e2e": "playwright test",
    "test:python": "uv run pytest",
    "setup:bun": "node tools/setup-bun.mjs",
    "setup:aria2": "node tools/setup-aria2.mjs",
    "test:runtime": "node tools/test-runtime.mjs",
    "test:desktop-runtime": "node tools/smoke-desktop-runtime.mjs",
    "test:desktop-webview": "node tools/smoke-webview-windows.mjs",
    "test:clean-linux": "node tools/smoke-clean-linux.mjs",
    "test:packaging": "node tools/probe-bun.mjs",
    "build:native-worker": "node tools/build-core-worker.mjs",
    "test:ui": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tauri-apps/cli": "^2.9.0",
    "@types/node": "^24.10.0",
    "ajv": "8.17.1",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "json-schema-to-typescript": "^15.0.4",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "^5.9.3"
  }
}
