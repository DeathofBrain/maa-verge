* text=auto eol=lf
*.ps1 text eol=crlf
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.woff2 binary
# Preserve upstream trailing blank lines in license and vendored sources.
LICENSE whitespace=-blank-at-eof
services/runtime/maaverge_runtime/vendor/** whitespace=-blank-at-eof
3rdparty/nlohmann-json/LICENSE.MIT whitespace=-blank-at-eol
3rdparty/aria2/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
# Upstream AUTHORS uses a seven-character Markdown underline, not a conflict marker.
3rdparty/aria2/notices/openssl-3.5.9/AUTHORS.md conflict-marker-size=32
